#!/usr/bin/env bash
set -euo pipefail

inhibitor_pid=""
last_state=""
last_dp=""

release_inhibitor() {
  [[ -n "$inhibitor_pid" ]] || return 0
  pkill -TERM -P "$inhibitor_pid" 2>/dev/null || true
  kill -KILL "$inhibitor_pid" 2>/dev/null || true
  wait "$inhibitor_pid" 2>/dev/null || true
  inhibitor_pid=""
}
cleanup() { release_inhibitor; }
trap cleanup EXIT
trap 'exit 0' INT TERM

ac_online() {
  local supply type
  for supply in /sys/class/power_supply/*; do
    [[ -r "$supply/type" ]] || continue
    type="$(<"$supply/type")"
    case "$type" in
      Mains|USB|USB_C|USB_PD)
        [[ "$(cat "$supply/online" 2>/dev/null || true)" == 1 ]] && return 0
        ;;
    esac
  done
  return 1
}

dp_connected() {
  local status
  for status in /sys/class/drm/card*-DP-*/status; do
    [[ -r "$status" ]] || continue
    [[ "$(<"$status")" == connected ]] && return 0
  done
  return 1
}

set_lid_inhibitor() {
  if [[ "$1" == enabled && -z "$inhibitor_pid" ]]; then
    systemd-inhibit --what=handle-lid-switch --mode=block \
      --who=work-laptop-dockd --why="Work laptop on external power" sleep infinity &
    inhibitor_pid=$!
  elif [[ "$1" == disabled && -n "$inhibitor_pid" ]]; then
    release_inhibitor
  fi
}

while true; do
  if dp_connected; then
    dp=connected
  else
    dp=disconnected
  fi

  if [[ -n "$last_dp" && "$dp" != "$last_dp" ]]; then
    printf 'DISPLAY %s; restarting Waybar\n' "$dp"
    systemctl --user restart waybar.service || printf 'FAILED to restart Waybar\n' >&2
  fi
  last_dp="$dp"

  if [[ "$dp" == connected ]] && ac_online; then
    state=docked
  elif ac_online; then
    state=ac-only
  else
    state=battery
  fi

  if [[ "$state" != "$last_state" ]]; then
    printf 'PROFILE %s\n' "$state"
    if [[ "$state" == docked ]]; then
      set_lid_inhibitor enabled
    else
      set_lid_inhibitor disabled
    fi
    last_state="$state"
  fi

  sleep 3
done
