#!/usr/bin/env bash
set -euo pipefail

config=work-mobile.jsonc
for status in /sys/class/drm/card*-DP-*/status; do
  [[ -r "$status" ]] || continue
  if [[ "$(<"$status")" == connected ]]; then
    config=work-docked.jsonc
    break
  fi
done

exec /usr/bin/waybar --config "$HOME/.config/waybar/$config"
