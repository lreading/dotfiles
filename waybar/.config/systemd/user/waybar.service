[Unit]
Description=Waybar
After=graphical-session.target
Requisite=graphical-session.target
PartOf=graphical-session.target

# Upstream WaybarStartup.sh starts this unit after
# WallpaperDaemon.sh has finished generating the wallpaper colors.
# WantedBy=graphical-session.target would start the bar too early and cause
# WallustSwww.sh to immediately reload it during login.

[Service]
ExecStart=/usr/bin/waybar
ExecReload=kill -SIGUSR2 $MAINPID
Restart=on-failure

[Install]
# An alias marks the service enabled for WaybarStartup.sh without attaching
# it to a target that would race wallpaper initialization.
Alias=hyprland-waybar.service
