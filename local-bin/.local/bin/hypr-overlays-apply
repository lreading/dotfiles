#!/usr/bin/env bash

set -euo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd -- "$(dirname -- "$script_path")/../../.." && pwd -P)"
overlay_dir="$repo_root/overlays"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
hypr_dir="$config_home/hypr"
waybar_dir="$config_home/hypr/waybar"

if [[ ! -d "$hypr_dir" || ! -d "$waybar_dir" ]]; then
  echo "Waybar is not installed at $waybar_dir." >&2
  echo "Run the upstream copy.sh upgrade first." >&2
  exit 1
fi

install -Dm644 "$overlay_dir/hypr/hypridle.conf" "$hypr_dir/hypridle.conf"
install -Dm644 "$overlay_dir/waybar/UserModules" "$waybar_dir/UserModules"
install -Dm644 "$overlay_dir/waybar/configs/Leo-Top-Laptop" "$waybar_dir/configs/Leo-Top-Laptop"
install -Dm644 "$overlay_dir/waybar/style/Leo-Latte-Wallust.css" "$waybar_dir/style/Leo-Latte-Wallust.css"

set_selection() {
  local target="$1"
  local destination="$2"

  if [[ -e "$destination" && ! -L "$destination" ]]; then
    echo "Refusing to replace regular file: $destination" >&2
    exit 1
  fi

  ln -sfn "$target" "$destination"
}

if [[ -f "$hypr_dir/work_laptop.lua" && -f "$hypr_dir/UserConfigs/waybar-workspaces.jsonc" ]]; then
  set_selection "../UserConfigs/waybar-workspaces.jsonc" "$waybar_dir/config"
else
  set_selection "configs/Leo-Top-Laptop" "$waybar_dir/config"
fi
set_selection "style/Leo-Latte-Wallust.css" "$waybar_dir/style.css"

hyprlock_palette="$hypr_dir/UserConfigs/leo-blue-gray-hyprlock.conf"
if [[ ! -f "$hyprlock_palette" ]]; then
  echo "Missing Hyprlock palette: $hyprlock_palette" >&2
  echo "Run stow -R hypr before applying overlays." >&2
  exit 1
fi

for hyprlock_config in "$hypr_dir/hyprlock.conf" "$hypr_dir/hyprlock-1080p.conf" "$hypr_dir/hyprlock-2k.conf"; do
  [[ -f "$hyprlock_config" ]] || continue
  sed -i \
    's|^source = \$HOME/\.config/hypr/wallust/wallust-hyprland\.conf$|source = $HOME/.config/hypr/UserConfigs/leo-blue-gray-hyprlock.conf|' \
    "$hyprlock_config"
done

rainbow_mode_file="$hypr_dir/UserScripts/rainbow-borders.mode"
rainbow_script="$hypr_dir/UserScripts/RainbowBorders.sh"
if [[ -f "$rainbow_mode_file" ]]; then
  rainbow_mode="$(tr -d '[:space:]' <"$rainbow_mode_file")"
  case "$rainbow_mode" in
  wallust_random | rainbow | gradient_flow)
    if [[ ! -f "$rainbow_script" ]]; then
      for disabled_script in "${rainbow_script}.bak" "$hypr_dir/UserScripts/RainbowBorders.bak.sh"; do
        if [[ -f "$disabled_script" ]]; then
          mv -- "$disabled_script" "$rainbow_script"
          break
        fi
      done
    fi
    if [[ -f "$rainbow_script" ]]; then
      sed -i "s/^EFFECT_TYPE=.*/EFFECT_TYPE=\"$rainbow_mode\"/" "$rainbow_script"
    fi
    ;;
  esac
fi

echo "Applied personal Hypridle, Hyprlock, Waybar, and Rainbow Borders overrides."
